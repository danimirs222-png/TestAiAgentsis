        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "trmt_eroded_dirt_0", "render_method": "opaque" }
          }
        }
      },
      {
        "condition": "q.block_state('trmt:stage') == 2",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "trmt_eroded_dirt_1", "render_method": "opaque" }
          }
        }
      },
      {
        "condition": "q.block_state('trmt:stage') == 3",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "trmt_eroded_dirt_2", "render_method": "opaque" }
          }
        }
      }
